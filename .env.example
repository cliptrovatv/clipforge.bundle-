# --- Required ---
DOMAIN=clips.example.com
POSTGRES_PASSWORD=generate-a-long-random-string
APP_PASSWORD=choose-a-strong-password
SESSION_SECRET=generate-a-long-random-string

# --- Optional (defaults shown) ---
MAX_CONCURRENT_RECORDINGS=8
CHECK_INTERVAL_SECONDS=60
RETENTION_DAYS=7
MIN_FREE_DISK_GB=20

# --- Local development only ---
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/clipforge
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/clipforge_test
# DATA_DIR=./data
